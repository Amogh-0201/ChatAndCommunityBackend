// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationRole {
  OWNER
  MEMBER
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  phoneNumber  String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Messages Sent by this user
  sentMessages     Message[]  @relation("SentMessages")
  
  // Conversations created by this user
  createdConversations Conversation[] @relation("CreatedConversations")

  // Conversations this user belongs to
  conversationMemberships ConversationMember[]

  authSessions AuthSession[]
}

model Conversation {
  id          String   @id @default(uuid())
  type        ConversationType
  name        String?
  directKey   String?  @unique

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The user who created this conversation
  createdBy   User     @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Restrict)

  // Users participating in this conversation
  members     ConversationMember[]

  // Messages belonging to this conversation
  messages    Message[]

  @@index([type, updatedAt])
}

model ConversationMember {
  conversationId String
  userId         String

  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can belong to a conversation only once
  @@id([conversationId, userId])

  @@index([userId, joinedAt])
}

model Message {
  id             String  @id @default(uuid())
  content        String

  senderId       String
  conversationId String

  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  
  @@index([senderId, createdAt])
  @@index([conversationId, createdAt])
}

model AuthSession {
  id            String   @id @default(uuid())
  userId        String
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  sessionId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}